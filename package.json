{
  "name": "signalforge",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source, production-minded AI web-research pipeline.",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --recursive --if-present run build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.30",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.3"
  }
}
