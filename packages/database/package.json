{
  "name": "@signalforge/database",
  "version": "0.1.0",
  "private": true,
  "description": "Database boundary for SignalForge.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:test": "prisma migrate deploy --config prisma.test.config.ts",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@signalforge/record-processing": "workspace:*",
    "@signalforge/schemas": "workspace:*",
    "ajv": "^8.17.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.3",
    "prisma": "^7.0.0",
    "tsx": "^4.19.4"
  }
}
